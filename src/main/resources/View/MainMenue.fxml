<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="800"
            style="-fx-background-color: linear-gradient(to bottom, #d7f8e7, #b1f1d1);"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainMenuController">

    <!-- MAIN CONTAINER -->
    <VBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <!-- LOGO -->
        <ImageView fx:id="imgLogo"
                   fitHeight="95"
                   fitWidth="95"
                   preserveRatio="true"/>

        <!-- APP TITLE -->
        <Label text="Aloka Pharmacy"
               maxWidth="Infinity"
               alignment="CENTER"
               style="-fx-font-size: 36px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1d8149;"/>

        <!-- WELCOME -->
        <Label fx:id="lblWelcome"
               maxWidth="Infinity"
               alignment="CENTER"
               text="Welcome"
               style="-fx-font-size: 18px;
                      -fx-text-fill: #1d8149;
                      -fx-padding: 5 0 15 0;
                      -fx-border-color: transparent transparent #1d8149 transparent;
                      -fx-border-width: 0 0 1 0;"/>

        <!-- BUTTON CONTAINER (CENTERED CARD STYLE) -->
        <VBox alignment="CENTER"
              spacing="22"
              style="-fx-background-color: rgba(255,255,255,0.25);
                     -fx-padding: 30;
                     -fx-background-radius: 20;">

            <GridPane alignment="CENTER" hgap="30" vgap="22">

                <JFXButton fx:id="btnGRN"
                           onAction="#btnGRNOnAction"
                           prefHeight="60"
                           prefWidth="200"
                           text="GRN"
                           style="-fx-background-color:#1d8149;
                                  -fx-text-fill:white;
                                  -fx-font-size:16px;
                                  -fx-font-weight:bold;
                                  -fx-background-radius:14;"/>

                <JFXButton fx:id="btnBilling"
                           onAction="#btnBillingOnAction"
                           prefHeight="60"
                           prefWidth="200"
                           text="Billing"
                           GridPane.columnIndex="1"
                           style="-fx-background-color:#1d8149;
                                  -fx-text-fill:white;
                                  -fx-font-size:16px;
                                  -fx-font-weight:bold;
                                  -fx-background-radius:14;"/>

                <JFXButton fx:id="btnReport"
                           onAction="#btnReportOnAction"
                           prefHeight="60"
                           prefWidth="200"
                           text="Reports"
                           GridPane.rowIndex="1"
                           style="-fx-background-color:#1d8149;
                                  -fx-text-fill:white;
                                  -fx-font-size:16px;
                                  -fx-font-weight:bold;
                                  -fx-background-radius:14;"/>

                <JFXButton fx:id="btnReturn"
                           onAction="#btnReturnOnAction"
                           prefHeight="60"
                           prefWidth="200"
                           text="Returns"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"
                           style="-fx-background-color:#1d8149;
                                  -fx-text-fill:white;
                                  -fx-font-size:16px;
                                  -fx-font-weight:bold;
                                  -fx-background-radius:14;"/>

            </GridPane>
        </VBox>

    </VBox>

</AnchorPane>
