<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="800"
            style="-fx-background-color: linear-gradient(to bottom, #d7f8e7, #b1f1d1);"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainMenuController">

    <VBox alignment="CENTER"
          layoutX="150"
          layoutY="30"
          prefWidth="500"
          spacing="18">

        <!-- LOGO -->
        <ImageView fx:id="imgLogo"
                   fitHeight="95"
                   fitWidth="95"
                   preserveRatio="true"/>

        <!-- APP TITLE -->
        <Label text="Aloka Pharmacy"
               prefWidth="500"
               alignment="CENTER"
               style="-fx-font-size: 36px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1d8149;" />

        <!-- WELCOME -->
        <Label fx:id="lblWelcome"
               prefWidth="500"
               alignment="CENTER"
               text="Welcome"
               style="-fx-font-size: 18px;
                      -fx-text-fill: #1d8149;
                      -fx-padding: 5 0 15 0;
                      -fx-border-color: transparent transparent #1d8149 transparent;
                      -fx-border-width: 0 0 1 0;" />

        <!-- BUTTON GRID -->
        <GridPane alignment="CENTER" hgap="35" vgap="28">

            <JFXButton fx:id="btnGRN"
                       onAction="#btnGRNOnAction"
                       prefHeight="60"
                       prefWidth="190"
                       text="GRN"
                       style="-fx-background-color:#1d8149;
                              -fx-text-fill:white;
                              -fx-font-size:16px;
                              -fx-font-weight:bold;
                              -fx-background-radius:14;" />

            <JFXButton fx:id="btnBilling"
                       onAction="#btnBillingOnAction"
                       prefHeight="60"
                       prefWidth="190"
                       text="Billing"
                       GridPane.columnIndex="1"
                       style="-fx-background-color:#1d8149;
                              -fx-text-fill:white;
                              -fx-font-size:16px;
                              -fx-font-weight:bold;
                              -fx-background-radius:14;" />

            <JFXButton fx:id="btnReport"
                       onAction="#btnReportOnAction"
                       prefHeight="60"
                       prefWidth="190"
                       text="Reports"
                       GridPane.rowIndex="1"
                       style="-fx-background-color:#1d8149;
                              -fx-text-fill:white;
                              -fx-font-size:16px;
                              -fx-font-weight:bold;
                              -fx-background-radius:14;" />

            <JFXButton fx:id="btnReturn"
                       onAction="#btnReturnOnAction"
                       prefHeight="60"
                       prefWidth="190"
                       text="Returns"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"
                       style="-fx-background-color:#1d8149;
                              -fx-text-fill:white;
                              -fx-font-size:16px;
                              -fx-font-weight:bold;
                              -fx-background-radius:14;" />

            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints percentHeight="50"/>
                <RowConstraints percentHeight="50"/>
            </rowConstraints>

        </GridPane>

    </VBox>

</AnchorPane>
